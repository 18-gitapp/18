#!/usr/bin/env bash
# VS Code تو مرورگر (code-server). سکرت CODE_PASSWORD رو توی ریپو بساز.
# با 31-tunnel.sh.example یک لینک https میگیری. نصب‌شدنش هم خودکار به شیفت بعد منتقل میشه.
command -v code-server >/dev/null || curl -fsSL https://code-server.dev/install.sh | sh
export PASSWORD="${CODE_PASSWORD:?سکرت CODE_PASSWORD رو بساز}"
exec code-server --bind-addr 127.0.0.1:8080 --auth password "$HOME"
