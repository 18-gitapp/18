#!/usr/bin/env bash
# ترمینال راه‌دور (SSH + لینک وب) بدون Tailscale. لینک رو از «لاگ زنده‌ی» همین job (تب Actions) بردار.
# ⚠️ هرکسی لینک رو داشته باشه شل کامل داره؛ ریپو باید Private باشه.
command -v tmate >/dev/null || sudo apt-get install -y -qq tmate >/dev/null
rm -f /tmp/tmate.sock
tmate -S /tmp/tmate.sock new-session -d || exit 1
tmate -S /tmp/tmate.sock wait tmate-ready
while tmate -S /tmp/tmate.sock has-session 2>/dev/null; do
  echo "SSH: $(tmate -S /tmp/tmate.sock display -p '#{tmate_ssh}')"
  echo "WEB: $(tmate -S /tmp/tmate.sock display -p '#{tmate_web}')"
  sleep 300
done
exit 1
